rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false; // Users cannot delete themselves via UI in MVP

      function isValidUser(data) {
        return data.keys().hasAll(['displayName', 'lastSeen'])
          && data.keys().size() <= 4
          && data.displayName is string && data.displayName.size() <= 64
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512))
          && (data.status == null || data.status in ['online', 'absent', 'in-meeting'])
          && data.lastSeen == request.time;
      }
    }

    // --- Presence ---
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidPresence(incoming());
      allow update: if isOwner(userId) && isValidPresence(incoming());
      allow delete: if isOwner(userId); // Users can clean up their presence when logging out

      function isValidPresence(data) {
        return data.keys().hasAll(['userId', 'x', 'y', 'scene', 'updatedAt'])
          && data.keys().size() == 5
          && data.userId == request.auth.uid
          && data.x is number
          && data.y is number
          && data.scene is string && data.scene.size() <= 64
          && data.updatedAt == request.time;
      }
    }

    // --- Chat ---
    match /chats/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }

    match /chats/{roomId}/typing/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
